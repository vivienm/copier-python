{% from "macros.jinja" import toml_string %}
{# I'd rather indent with two spaces, but this clashes with uv's formatting. #}
[project]
name = {{ toml_string(module_name | replace('_', '-')) }}
version = "0.1.0"
description = {{ toml_string(project_description.removesuffix('.')) }}
readme = "README.md"
authors = [
    { name = {{ toml_string(user_name) }}, email = {{ toml_string(user_email) }} },
]
license = "{% if license == 'Proprietary' %}LicenseRef-Proprietary{% else %}{{ license }}{% endif %}"
classifiers = ["Private :: Do Not Upload"]
requires-python = ">={{ python_version }}"
{% if project_type == "application" %}
dependencies = [
    "typer>=0.27.3",
]
{% else %}
dependencies = []
{% endif %}
{% if project_type == "application" %}

[project.scripts]
{{ script_name }} = "{{ module_name }}.__main__:app"
{% endif %}

[project.urls]
{% if pages_url %}
Documentation = {{ toml_string(pages_url ~ "/docs/") }}
{% endif %}
{% if repo_url %}
Repository = {{ toml_string(repo_url) }}
{% if forge == "github" %}
Issues = {{ toml_string(repo_url ~ "/issues") }}
{% endif %}
{% endif %}
{% if project_type != "bare" %}

[build-system]
{% if build_system == "uv" %}
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"
{% elif build_system == "hatchling" %}
requires = ["hatchling>=1.32.4"]
build-backend = "hatchling.build"
{% elif build_system == "maturin" %}
requires = ["maturin>=1.15.0,<2.0"]
build-backend = "maturin"
{% endif %}
{% endif %}

[dependency-groups]
dev = [
{% if doc_generator == "sphinx" %}
    "furo>=2025.12.19",
{% endif %}
{% if test_runner == "pytest" %}
    "pytest>=9.1.1",
    "pytest-randomly>=5.0.0",
{% endif %}
    "ruff>=0.17.3",
    "rust-just>=1.59.0",
{% if doc_generator == "sphinx" %}
{# Sphinx 9.1 requires Python 3.12; Sphinx 9.2 requires Python 3.13. #}
{% if python_version_info >= [3, 13] %}
    "sphinx>=9.2.0",
{% elif python_version_info >= [3, 12] %}
    "sphinx>=9.1.1",
{% else %}
    "sphinx>=9.0.4",
{% endif %}
{% endif %}
    "ty>=0.0.92",
    "typos>=1.51.1",
]
{% if build_system == "maturin" %}

[tool.uv]
cache-keys = [
    { file = "pyproject.toml" },
    { file = "Cargo.toml" },
    { file = "Cargo.lock" },
    { file = "src/**/*.rs" },
]

[tool.maturin]
python-source = "python"
module-name = "{{ module_name }}._core"
{% endif %}

[tool.ruff.lint]
extend-select = [
    "I",  # isort
    "RUF",  # Ruff
{# https://docs.astral.sh/ty/reference/typing-faq/#does-ty-have-a-strict-mode #}
    "ANN",  # Annotations
]
unfixable = [
    "F401",  # unused imports
]
{% if test_runner == "pytest" %}

[tool.pytest.ini_options]
addopts = [
    "--doctest-modules",
    "--import-mode=importlib",
]
testpaths = [
{% if build_system == "maturin" %}
    "python",
{% elif project_type != "bare" %}
    "src",
{% endif %}
    "tests",
]
filterwarnings = [
    "error",
]
{% endif %}
{% if doc_generator == "sphinx" %}

[tool.typos.files]
extend-exclude = [
    "docs/_build/*",
]
{% endif %}
