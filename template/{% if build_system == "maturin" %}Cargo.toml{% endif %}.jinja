[package]
name = "{{ package_name }}"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "_{{ module_name }}"
crate-type = ["cdylib"]

[dependencies]
pyo3 = { version = "0.30.1", features = ["abi3-py3{% if python_version_info >= [3, 15] %}15{% else %}{{ python_version_info[1] }}{% endif %}"] }
